# Database lokal (SQLite)
DATABASE_URL="file:./dev.db"

# === Authentication (Lucia Auth) ===
# Generate dengan: openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# === Untuk fitur AI Scan Struk (Milestone 4) ===
# API key dari dashboard Sumopod (sumopod.com/dashboard/ai), format sk-...
SUMOPOD_API_KEY=""
# Base URL AI Gateway Sumopod (OpenAI-compatible)
SUMOPOD_BASE_URL="https://ai.sumopod.com/v1"
# Model vision yang dipakai membaca struk (pilihan: gpt-4o, gpt-4o-mini, gpt-4.1,
# gemini-2.5-flash, dll — lihat daftar model di dashboard)
SUMOPOD_VISION_MODEL="gpt-4o-mini"
# Mode pengembangan tanpa memanggil AI sungguhan (1 = parse dummy, 0 = AI asli)
SCAN_MOCK_MODE="0"

# === Midtrans Payment Gateway ===
# Dapatkan dari dashboard Midtrans (sandbox/production)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
# URL aplikasi untuk callback pembayaran
NEXT_PUBLIC_APP_URL="http://localhost:3000"